{
  "name": "luma-torch",
  "version": "1.0.0",
  "description": "A private, document-scoped PDF flashlight for Linux.",
  "author": "LumaTorch",
  "homepage": "https://example.invalid/lumatorch",
  "desktopName": "LumaTorch",
  "license": "MIT",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "start": "concurrently -k -n ANGULAR,ELECTRON -c cyan,magenta \"npm:serve\" \"npm:electron:dev\"",
    "serve": "ng serve --host 127.0.0.1 --port 4200",
    "electron:dev": "wait-on http://127.0.0.1:4200 && cross-env ELECTRON_START_URL=http://127.0.0.1:4200 electron .",
    "build": "ng build --configuration production && npm run build:electron",
    "build:electron": "tsc -p tsconfig.electron.json",
    "package:linux": "npm run build && electron-builder --linux rpm AppImage",
    "package:rpm": "npm run build && electron-builder --linux rpm",
    "package:appimage": "npm run build && electron-builder --linux AppImage",
    "test": "ng test --watch=false"
  },
  "devDependencies": {
    "@angular/common": "21.2.26",
    "@angular/compiler": "21.2.26",
    "@angular/core": "21.2.26",
    "@angular/platform-browser": "21.2.26",
    "pdfjs-dist": "6.5.438",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.16.1",
    "@angular/build": "21.2.30",
    "@angular/cli": "21.2.30",
    "@angular/compiler-cli": "21.2.26",
    "@types/node": "22.20.5",
    "concurrently": "9.2.5",
    "cross-env": "10.1.0",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "jsdom": "31.0.1",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "vite": "7.3.7",
    "wait-on": "9.0.3"
  },
  "build": {
    "appId": "com.lumatorch.desktop",
    "productName": "LumaTorch",
    "directories": {
      "output": "outputs/linux"
    },
    "files": [
      "dist-electron/**/*",
      "dist/luma-torch/browser/**/*",
      "package.json"
    ],
    "linux": {
      "category": "Graphics",
      "icon": "build/icons",
      "maintainer": "LumaTorch project",
      "syncDesktopName": true,
      "target": [
        "rpm",
        "AppImage"
      ],
      "synopsis": "A focused flashlight for PDF documents",
      "description": "A local PDF viewer with a circular reading spotlight."
    },
    "rpm": {
      "compression": "gzip"
    }
  }
}
